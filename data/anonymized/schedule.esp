NOTIFY FAILURE ABEND ALERT(APP2040)

JOB JOB3596 LINK PROCESS
   RUN DAILY
   DELAYSUB 19.55
   IF TODAY('SUN') THEN EARLYSUB 14.55
   IF TODAY('1ST DAY OF MONTH') AND TODAY('WEEKDAY SAT') -
   THEN EARLYSUB 18.55
   IF TODAY('APR 7 2019') THEN JOBATTR HOLD
   IF TODAY('APR 21 2023')      AND -
   ESPSHH EQ '17'  THEN DO
     DELAYSUB 18.00
   ENDDO
   SAP973 ADD(JOB5580)
   SAP973 ADD(JOB5587)
   SAP973 ADD(JOB6002)
   SAP973 ADD(JOB5594)
   SAP973 ADD(JOB2823)
ENDJOB

