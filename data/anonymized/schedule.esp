JOB JOB0147 EXTERNAL APPLID(APP0028) ANON00051(-01)
   RUN DAILY
   IF SYM0191('DEC 16,2022') GE 0 -
   AND SYM0192('JAN 01,2023') GE 0 -
   THEN NORUN DAILY
   IF SYM0191('DEC 14,2023') GE 0 -
   AND SYM0192('JAN 01,2024') GE 0 -
   THEN NORUN DAILY
   IF TODAY('DEC 17 2020') AND SYM0004 GT '18' THEN NORUN TODAY
   INVOKE 'SYS.ESP.PROCLIB(#SYM0285)'
   RELEASE ADD(JOB0003)
ENDJOB

