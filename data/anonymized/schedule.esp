IN_QUAL = SYM0479('!MNQUAL')
IF SUBSTR(IN_QUAL,1,1) = '~' THEN
  DO
    SYM0441 = 'N'
  END

"SYM0441='"SYM0441"'"

REXXOFF

IF !SYM0441 = 'N' THEN -
  DO
    SYM0867='JOB !SYM0411'
    SYM0868='A JOB IN APPL !MNAPPL FAILED WITH CC !MNCMPC..'
    SYM0869='JOB !SYM0411'
  ENDDO
ELSE -
  DO
    SYM0867='JOB !SYM0106'
    SYM0868='A JOB IN APPL !MNAPPL FAILED WITH CC !MNCMPC..'
    SYM0869='JOB !SYM0106'
  ENDDO

SYM0870='IN APPL !MNAPPL GEN# !SYM0449 HAS FAILED.'

IF !MNAGENT = '' THEN -
  DO
    SYM0892='SAP1174 JES JOB# IS !MNJOBNO WHICH'
    SYM0893='STARTED AT !SYM0508..'
    SYM0894='THIS IS A Z/OS JOB WHICH RAN ON SYSTEM !MNSYS..'
  ENDDO
ELSE -
  DO
    SYM0892='SAP1174 JOB# IS !MNJOBNO WHICH'
    SYM0893='STARTED AT !SYM0508..'
    SYM0894='SAP1174 AGENT IS !MNAGENT..'
  ENDDO

SYM0895='!SYM0411'

SYM0525='!'

DOIT = '?'

REXXON GEN

DOIT = '?'
IN_APPL = SYM0479('!MNAPPL')
SYM0400 = SYM0479('!SYM0449')
IN_JOB = SYM0479('!MNJOB')
IN_QUAL = SYM0479('!MNQUAL')
IF IN_QUAL = ''  THEN
  DO
    SYM0401 = IN_JOB
  END
ELSE
  DO
    SYM0401 = IN_JOB || '.' || IN_QUAL
  END
IN_TAG = SYM0479('!MNTAG')

IF SUBSTR(IN_TAG,3,4) = 'XXXX' THEN
  DO
    DOIT = 'SYM0970'
    SIGNAL SYM0472
  END

SYM0352 = 'ESP LAP' IN_APPL || '.' || SYM0400 'SAP088'

X=TRAPOUT('HOLD.')

""SYM0352""

X=TRAPOUT('OFF')

PARSE VAR HOLD.1 SYM0351 SYM0505 SYM0402 LAP_GEN SYM0570

IF SYM0351  \= 'APPL'     |,
  SYM0505      \= IN_APPL    |,
  SYM0402    \= 'GEN'      |,
  LAP_GEN       \= SYM0400 THEN
  DO
    DOIT = 'YES'
    SIGNAL SYM0472
  END

DO I = 2
  IF HOLD.I = '' THEN
    DO
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' THEN
    DO
      DOIT = 'YES'
      SIGNAL SYM0472
    END
  IF SUBSTR(HOLD.I,1,2) = '  ' THEN
    DO
      PARSE VAR HOLD.I LAP_1 SYM0570
      IF LAP_1 = SYM0401 THEN
        DO
          J = I + 1
          SIGNAL SYM0910
        END
    END
END

SYM0910:

DO I = J
  IF HOLD.I = '' THEN
    DO
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' |,
     SUBSTR(HOLD.I,3,1) \= ' ' THEN
    DO
      DOIT = 'YES'
      SIGNAL SYM0472
    END
  PARSE VAR HOLD.I LAP_1 LAP_2 SYM0570
  IF LAP_1 = 'RERUN' & LAP_2 = 'OF:' THEN
    DO
      DOIT = 'NO'
      SIGNAL SYM0472
    END
END

SYM0472:

"DOIT='"DOIT"'"

REXXOFF

JOB JOB5012
  IF !DOIT = 'YES' THEN RUN NOW
ENDJOB

