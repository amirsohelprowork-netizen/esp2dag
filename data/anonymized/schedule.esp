JOB JOB0002 LINK PROCESS
   DUEOUT EXEC NOW PLUS 5 HOURS
   IF TODAY('MON OR WED') THEN DUEOUT EXEC NOW PLUS 12 HOURS
   IF TODAY('SUN') THEN DUEOUT EXEC 13.00
   RUN DAILY
ENDJOB

