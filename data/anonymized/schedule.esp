   RUN DAILY
   DELAYSUB 21.30
   IF TODAY('SUN') THEN EARLYSUB 16.00
   IF TODAY('APR 21 2023')      AND -
    ESPSHH EQ '17'  THEN DO
     DELAYSUB 18.00
   ENDDO
   SAP973 ADD(JOB5577)
ENDJOB

