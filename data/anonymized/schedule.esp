NOTIFY FAILURE ABEND ALERT(APP2040)

JOB APP144

NOTIFY ABEND FAILURE ALERT(APP2040)

   REXXON

     APPLN=SYM0479('!USER1')
     APPLG=SYM0479('!USER2')
     SUBAP=SYM0479('!USER3')
     JOBNAME=SYM0479('!USER4')
     SUBSYS=SYM0479('!SYM0437')

    IF JOBNAME = '' & SUBAP = '' THEN DO
        "ESP LAP "APPLN"."APPLG" SAP088"
      X = TRAPOUT('LINE.')
        "ESP LAP "APPLN"."APPLG" SAP088"
      X = TRAPOUT('OFF')
    END

    IF SUBAP ^= '' THEN DO
      X = TRAPOUT('LINE.')
        "ESP LAP "APPLN"."APPLG" SUBAPPL("SUBAP") SAP088"
      X = TRAPOUT('OFF')
    END

    IF JOBNAME ^= '' THEN DO
      X = TRAPOUT('LINE.')
        "ESP LAP "APPLN"."APPLG" JOB("JOBNAME")"
      X = TRAPOUT('OFF')
    END

      DO I=1 TO LINE.0
        CHKSTR1=WORD(LINE.I,1)
        SYM0455 = POS(".",CHKSTR1)
        IF SYM0455 > 0 THEN CHKSTR1 = LEFT(CHKSTR1,SYM0455 - 1)
        CHKSTR2=WORD(LINE.I,2)
        CHKSTR2=STRIP(CHKSTR2,,',')
        CHKSTR3=WORD(LINE.I,3)
        CHKSTR3=STRIP(CHKSTR3,,',')

    "ALLOCX DA('SYM0174(#DISTRIB)') F(MYINDD) SH"
       IF I = 1 THEN DO
     QUEUE "//SYM0575 JOB (XXXXXX,CSG2),SYM0513=X,CLASS=H,"
     QUEUE "//         USER=TSOXXXX,GROUP=JCJC"
       END

           IF INDEX(CHKSTR3,'SYM0429') > 0 THEN DO
             QUEUE "//"CHKSTR1" EXEC SYM0553"
             QUEUE "//SYM0493 DD *"
             QUEUE "SUBSYS ESPP"
             QUEUE "TYPE APP146"
             QUEUE "JOBNAME "CHKSTR1""
             QUEUE "JOBID "CHKSTR2""
             QUEUE "

