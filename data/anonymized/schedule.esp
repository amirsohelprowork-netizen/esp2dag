AIX_JOB JOB3586 EXTERNAL APPLID(APP2680) SCOPE(-01)
    RUN DAILY
    IF DAYS_FROM('DEC 16,2022') GE 0 -
    AND DAYS_TO('JAN 01,2023') GE 0 -
    THEN NORUN DAILY
    IF TODAY('DEC 17 2020') AND ESPSHH GT '18' THEN NORUN TODAY
    IF DAYS_FROM('DEC 14,2023') GE 0 -
    AND DAYS_TO('JAN 01,2024') GE 0 -
    THEN NORUN DAILY
    INVOKE 'SYS.ESP.PROCLIB(APP016)'
    SAP973 ADD(JOB3596)
ENDJOB

