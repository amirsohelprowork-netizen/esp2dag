APPL APP892 WAIT

INVOKE 'SYM0174(APP006)'

NOTIFY FAILURE ABEND ALERT(APP2040)

JOB JOB3596 LINK PROCESS
  RUN DAILY
  DELAYSUB 10:00
  SAP973 ADD(APP892)
ENDJOB

JOB APP892

NOTIFY FAILURE ABEND ALERT(APP2040)

JOB JOB3596 LINK PROCESS
  RUN SAT
  DELAYSUB 10:10
  SAP973 ADD(APP893)
ENDJOB

JOB APP893

SYM0511    = SYM0479('!MNAPPL')
MON_JOB     = SYM0479('!MNJOB')
SYM0512    = SYM0479('!MNMXRC')

SYM0890 = SYM0511 || '.' || MON_JOB || '.APPLJOB'

SYM0445 "SYM0257 =" SYM0511"."MON_JOB".APPLJOB"

IF SYM0257 = SYM0890 THEN
  DO
    SYM0896 = 'NO SAP1168 ENTRY FOUND FOR APPL' -
                     SYM0511 'JOB' MON_JOB
    SYM0198   = 'YES'
    SIGNAL SYM0472
  END

MON_TAG     = SYM0479('!MNTAG')

SYM0499#   = POS('RUN#',MON_TAG)

IF SYM0499# = 0 THEN
  DO
    SYM0896 = 'NO RUN# FOUND IN TAG FOR APPL' -
                     SYM0511 'JOB' MON_JOB
    SYM0198   = 'YES'
    SIGNAL SYM0472
  END
ELSE
  DO
    GOT_IT = SYM0499# + 4
    MON_RUN# = SUBSTR(MON_TAG,GOT_IT,2)
    MON_RUN# = STRIP(MON_RUN#)
    SYM0438 = SYM0484(MON_RUN#)
    IF SYM0438 \= 'NUM' THEN
      DO
        SYM0896 = 'RUN# IN TAG IS INVALID FOR APPL' -
                         SYM0511 'JOB' MON_JOB
        SYM0897 = 'RUN# FOUND IN TAG IS' MON_RUN#
        SYM0198   = 'YES'
        SIGNAL SYM0472
      END
  END

SYM0445 "SYM0310 =" SYM0511"."MON_JOB".RETRYS"
SYM0445 "SYM0419   =" SYM0511"."MON_JOB".WAIT"
SYM0445 "SYM0309 =" SYM0511"."MON_JOB".GIVEUP"
SYM0445 "SYM0308 =" SYM0511"."MON_JOB"."SYM0512

IF SYM0308 = 'COMPIT' |,
   SYM0308 = 'FAILIT' |,
   SYM0308 = 'SYM0515' |,
   SYM0308 = 'SYM0520' |,
   SYM0308 = 'RERUNIT' THEN
  DO
    NOP
  END
ELSE
  DO
    SYM0445 "SYM0308 =" SYM0511"."MON_JOB".OTHER"
  END

SELECT
  WHEN SYM0308 = 'COMPIT' THEN
    SYM0197   = 'YES'
  WHEN SYM0308 = 'FAILIT' THEN
    SYM0198   = 'YES'
  WHEN SYM0308 = 'SYM0515' THEN
    SYM0845 = 'YES'
  WHEN SYM0308 = 'SYM0520' THEN
    SYM0846 = 'YES'
  WHEN SYM0308 = 'RERUNIT' THEN
    DO
      IF MON_RUN# <= SYM0310 THEN
        DO
          NEW_RUN# = MON_RUN# + 1
          SYM0896 = 'SYM0460 APPL' -
                           SYM0511 'JOB' MON_JOB
          SYM0897 = 'THIS WILL BE RUN#' NEW_RUN#
          SYM0169  = 'YES'
          SYM0283 = SYM0419
        END
      ELSE
        DO
          SELECT
            WHEN SYM0309 = 'COMPIT' THEN
              DO
                SYM0896 = 'RERUN LIMIT SYM0498 FOR APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0897 = 'SYM0390 APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0197   = 'YES'
              END
            WHEN SYM0309 = 'FAILIT' THEN
              DO
                SYM0896 = 'RERUN LIMIT SYM0498 FOR APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0897 = 'FAILING APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0198   = 'YES'
              END
            SYM0454
              DO
                SYM0896 = 'INVALID GIVEUP VALUE FOR APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0897 = 'SAP1174 INVALID VALUE IS' SYM0309
                SYM0198   = 'YES'
                SIGNAL SYM0472
              END
            END
        END
    END
  SYM0454
    DO
      SYM0896 = 'INVALID SAP1168 ACTION FOUND FOR APPL' -
                       SYM0511
      SYM0897 = 'SAP1174 INVALID VALUE IS' SYM0308
    END
  END

SYM0472:

"SYM0197='"SYM0197"'"
"SYM0198='"SYM0198"'"
"SYM0845='"SYM0845"'"
"SYM0846='"SYM0846"'"
"SYM0169='"SYM0169"'"
"SYM0283='"SYM0283"'"
"SYM0896='"SYM0896"'"
"SYM0897='"SYM0897"'"

REXXOFF

IF SYM0198 = 'YES' THEN -
  DO
    JOB JOB5022 LINK PROCESS
             DATASET(SYM0271) MEMBER(SYM0561)
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0846 = 'YES' THEN -
  DO
    JOB JOB3998 LINK PROCESS
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0197 = 'YES' THEN -
  DO
    JOB JOB1382 LINK PROCESS
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0169 = 'YES' THEN -
  DO
    JOB JOB4329 LINK PROCESS
      EARLYSUB NOW PLUS !SYM0283 MINUTES
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0896 NE 'NONE' THEN -
  SEND 'APP894-!SYM0896'
IF SYM0897 NE 'NONE' THEN -
  SEND 'APP894-!SYM0897'

APPL APP895

SYM0197   = 'NO'
SYM0198   = 'NO'
SYM0845 = 'NO'
SYM0846 = 'NO'
SYM0169  = 'NO'
SYM0283     = 1
SYM0896    = 'NONE'
SYM0897    = 'NONE'

REXXON GEN PROC

SYM0197   = 'NO'
SYM0198   = 'NO'
SYM0845 = 'NO'
SYM0846 = 'NO'
SYM0169  = 'NO'
SYM0283     = 1
SYM0896    = 'NONE'
SYM0897    = 'NONE'

SYM0243.              = ''
SYM0077       = 'SYM0243'
SYM0088        = 1
SYM0131          = 30
SYM0087        = 'COMPIT'
