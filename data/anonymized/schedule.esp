""SYM0352""

X=TRAPOUT('OFF')

PARSE VAR HOLD.1 SYM0351 SYM0505 SYM0402 LAP_GEN SYM0570

IF SYM0351  \= 'APPL'     |,
  SYM0505      \= IN_APPL    |,
  SYM0402    \= 'GEN'      |,
  LAP_GEN       \= SYM0400 THEN
  DO
    DOIT = 'YES'
    SIGNAL SYM0472
  END

DO I = 2
  IF HOLD.I = '' THEN
    DO
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' THEN
    DO
      DOIT = 'YES'
      SIGNAL SYM0472
    END
  IF SUBSTR(HOLD.I,1,2) = '  ' THEN
    DO
      PARSE VAR HOLD.I LAP_1 SYM0570
      IF LAP_1 = SYM0401 THEN
        DO
          J = I + 1
          SIGNAL SYM0910
        END
    END
END

SYM0910:

DO I = J
  IF HOLD.I = '' THEN
    DO
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' |,
     SUBSTR(HOLD.I,3,1) \= ' ' THEN
    DO
      DOIT = 'YES'
      SIGNAL SYM0472
    END
  PARSE VAR HOLD.I LAP_1 LAP_2 SYM0570
  IF LAP_1 = 'Rerun' & LAP_2 = 'of:' THEN
    DO
      DOIT = 'NO'
      SIGNAL SYM0472
    END
END

SYM0472:

"DOIT='"DOIT"'"

REXXOFF

JOB JOB3596 LINK PROCESS
   RUN NOW
   SAP973 ADD(JOB5013)
   SAP973 ADD(JOB4995)
ENDJOB

JOB JOB5013
  IF !DOIT = 'YES' THEN RUN NOW
  SAP973 ADD(JOB3495)
ENDJOB

JOB JOB4995

