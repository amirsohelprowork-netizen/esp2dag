SYM0064       = 'SYM0515'

SYM0162.            = ''
SYM0051     = 'SYM0162'
SYM0067      = 4
SYM0091        = 5
SYM0066      = 'FAILIT'
SYM0141           = 'SYM0520'
SYM0142           = 'RERUNIT'
SYM0079       = 'SYM0515'

SYM0252.              = ''
SYM0082       = 'SYM0252'
SYM0095        = 2
SYM0136          = 15
SYM0094        = 'FAILIT'
SYM0168             = 'SYM0520'
SYM0151            = 'RERUNIT'
SYM0107         = 'FAILIT'

SYM0134.          = ''
SYM0010   = 'SYM0134'
SYM0019    = 2
SYM0053      = 1
SYM0018    = 'SYM0520'
SYM0092         = 'RERUNIT'
SYM0093         = 'RERUNIT'
SYM0034     = 'SYM0520'

SYM0139.          = ''
SYM0014   = 'SYM0139'
SYM0028    = 3
SYM0065      = 1
SYM0027    = 'COMPIT'
SYM0100         = 'RERUNIT'
SYM0101         = 'RERUNIT'
SYM0102         = 'RERUNIT'
SYM0103         = 'RERUNIT'
SYM0047     = 'RERUNIT'

SYM0511    = SYM0479('!MNAPPL')
MON_JOB     = SYM0479('!MNJOB')
SYM0512    = SYM0479('!MNMXRC')

SYM0890 = SYM0511 || '.' || MON_JOB || '.APPLJOB'

SYM0445 "SYM0257 =" SYM0511"."MON_JOB".APPLJOB"

IF SYM0257 = SYM0890 THEN
  DO
    SYM0896 = 'NO SAP1168 ENTRY FOUND FOR APPL' -
                     SYM0511 'JOB' MON_JOB
    SYM0198   = 'YES'
    SIGNAL SYM0472
  END

MON_TAG     = SYM0479('!MNTAG')

SYM0499#   = POS('RUN#',MON_TAG)

IF SYM0499# = 0 THEN
  DO
    SYM0896 = 'NO RUN# FOUND IN TAG FOR APPL' -
                     SYM0511 'JOB' MON_JOB
    SYM0198   = 'YES'
    SIGNAL SYM0472
  END
ELSE
  DO
    GOT_IT = SYM0499# + 4
    MON_RUN# = SUBSTR(MON_TAG,GOT_IT,2)
    MON_RUN# = STRIP(MON_RUN#)
    SYM0438 = SYM0484(MON_RUN#)
    IF SYM0438 \= 'NUM' THEN
      DO
        SYM0896 = 'RUN# IN TAG IS INVALID FOR APPL' -
                         SYM0511 'JOB' MON_JOB
        SYM0897 = 'RUN# FOUND IN TAG IS' MON_RUN#
        SYM0198   = 'YES'
        SIGNAL SYM0472
      END
  END

SYM0445 "SYM0310 =" SYM0511"."MON_JOB".RETRYS"
SYM0445 "SYM0419   =" SYM0511"."MON_JOB".WAIT"
SYM0445 "SYM0309 =" SYM0511"."MON_JOB".GIVEUP"
SYM0445 "SYM0308 =" SYM0511"."MON_JOB"."SYM0512

IF SYM0308 = 'COMPIT' |,
   SYM0308 = 'FAILIT' |,
   SYM0308 = 'SYM0515' |,
   SYM0308 = 'SYM0520' |,
   SYM0308 = 'RERUNIT' THEN
  DO
    NOP
  END
ELSE
  DO
    SYM0445 "SYM0308 =" SYM0511"."MON_JOB".OTHER"
  END

SELECT
  WHEN SYM0308 = 'COMPIT' THEN
    SYM0197   = 'YES'
  WHEN SYM0308 = 'FAILIT' THEN
    SYM0198   = 'YES'
  WHEN SYM0308 = 'SYM0515' THEN
    SYM0845 = 'YES'
  WHEN SYM0308 = 'SYM0520' THEN
    SYM0846 = 'YES'
  WHEN SYM0308 = 'RERUNIT' THEN
    DO
      IF MON_RUN# <= SYM0310 THEN
        DO
          NEW_RUN# = MON_RUN# + 1
          SYM0896 = 'SYM0460 APPL' -
                           SYM0511 'JOB' MON_JOB
          SYM0897 = 'THIS WILL BE RUN#' NEW_RUN#
          SYM0169  = 'YES'
          SYM0283 = SYM0419
        END
      ELSE
        DO
          SELECT
            WHEN SYM0309 = 'COMPIT' THEN
              DO
                SYM0896 = 'RERUN LIMIT SYM0498 FOR APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0897 = 'SYM0390 APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0197   = 'YES'
              END
            WHEN SYM0309 = 'FAILIT' THEN
              DO
                SYM0896 = 'RERUN LIMIT SYM0498 FOR APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0897 = 'FAILING APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0198   = 'YES'
              END
            SYM0454
              DO
                SYM0896 = 'INVALID GIVEUP VALUE FOR APPL' -
                                 SYM0511 'JOB' MON_JOB
                SYM0897 = 'SAP1174 INVALID VALUE IS' SYM0309
                SYM0198   = 'YES'
                SIGNAL SYM0472
              END
            END
        END
    END
  SYM0454
    DO
      SYM0896 = 'INVALID SAP1168 ACTION FOUND FOR APPL' -
                       SYM0511
      SYM0897 = 'SAP1174 INVALID VALUE IS' SYM0308
    END
  END

SYM0472:

"SYM0197='"SYM0197"'"
"SYM0198='"SYM0198"'"
"SYM0845='"SYM0845"'"
"SYM0846='"SYM0846"'"
"SYM0169='"SYM0169"'"
"SYM0283='"SYM0283"'"
"SYM0896='"SYM0896"'"
"SYM0897='"SYM0897"'"

REXXOFF

IF SYM0198 = 'YES' THEN -
  DO
    JOB JOB5022 LINK PROCESS
             DATASET(SYM0271) MEMBER(SYM0561)
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0846 = 'YES' THEN -
  DO
    JOB JOB3998 LINK PROCESS
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0197 = 'YES' THEN -
  DO
    JOB JOB1382 LINK PROCESS
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0169 = 'YES' THEN -
  DO
    JOB JOB4329 LINK PROCESS
      EARLYSUB NOW PLUS !SYM0283 MINUTES
      RUN NOW
    ENDJOB
  ENDDO

IF SYM0896 NE 'NONE' THEN -
  SEND 'APP895-!SYM0896'
IF SYM0897 NE 'NONE' THEN -
  SEND 'APP895-!SYM0897'

