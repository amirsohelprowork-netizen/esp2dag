INVOKE 'SYM0174(APP006)'

SEND_IT = 'NO'
SYM0909    = '#FFFF00'
SYM0857 = ' '
SYM0858 = ' '
SYM0859 = ' '
SYM0860 = ' '
SYM0861 = ' '
SYM0896   = ' '
SYM0897   = ' '
SYM0898   = ' '
SYM0899   = ' '
SYM0900   = ' '
SYM0901   = ' '
SYM0902   = ' '
SYM0903   = ' '
SYM0904   = ' '
SYM0872  = ' '

JOB JOB4992

  IF (!MNJOB EQ 'SYM0489' OR -
      !MNJOB EQ 'SYM0490') AND -
      !MNMXRC NE 0 THEN -
     DO
       SEND_IT         = 'YES'
       SYM0909    = '#FFFF00'
       SYM0857 = 'rcpt to:<bfisservice@REDACTED.com>'
       SYM0896   = 'Job !MNJOB in application !MNAPPL has ended'
       SYM0897   = 'with a maximum RC of !MNMXRC..'
     ENDDO

IF !MNAPPL EQ 'SYM0491' THEN -
   DO
   ENDDO

  IF SEND_IT = 'YES' THEN RUN NOW

ENDJOB

IF !MNAPPL EQ 'APP762' -
 or -
IF !MNAPPL EQ 'APP1243' -
 or -
IF !MNAPPL EQ 'APP1244' -
 or -
IF !MNAPPL EQ 'APP1245' -
 THEN -
   DO
   ENDDO

IF !MNAPPL EQ 'APP1243' THEN -
   DO
   ENDDO

