  LAP_APPL      \= IN_APPL    |,
  LAP_GENCON    \= 'GEN'      |,
  LAP_GEN       \= IN_APPLGEN THEN
  DO
    DOIT = 'YES'
    SIGNAL ALL_DONE
  END

/* redacted */

DO I = 2
  IF HOLD.I = '' THEN                    /* redacted */
    DO                                   /* redacted */
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' THEN   /* redacted */
    DO                                   /* redacted */
      /* redacted */
      DOIT = 'YES'
      SIGNAL ALL_DONE
    END
  IF SUBSTR(HOLD.I,1,2) = '  ' THEN
    DO
      PARSE VAR HOLD.I LAP_1 THE_REST
      IF LAP_1 = IN_JOBQUAL THEN
        DO
          /* redacted */
          J = I + 1
          SIGNAL FOUND_IN_JOB
        END
    END
END


FOUND_IN_JOB:

DO I = J
  IF HOLD.I = '' THEN                 /* redacted */
    DO                                /* redacted */
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' |,  /* redacted */
     SUBSTR(HOLD.I,3,1) \= ' ' THEN   /* redacted */
    DO                                /* redacted */
      /* redacted */
      DOIT = 'YES'
      SIGNAL ALL_DONE
    END
  PARSE VAR HOLD.I LAP_1 LAP_2 THE_REST
  IF LAP_1 = 'RERUN' & LAP_2 = 'OF:' THEN  /* redacted */
    DO                                     /* redacted */
      /* redacted */
      DOIT = 'NO'
      SIGNAL ALL_DONE
    END
END

