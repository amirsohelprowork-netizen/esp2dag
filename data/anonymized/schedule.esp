/* redacted */
/* redacted */

IF TABLE_APPLJOB = NO_TABLE_ENTRY THEN
  DO
    LATE_SEND_IT = 'NO'
    LATE_MESSAGE_1 = 'NO SAP1168 ENTRY FOUND FOR APPL' -
                     MON_APPL 'JOB' MON_JOB
    SIGNAL ALL_DONE
  END

/* redacted */

