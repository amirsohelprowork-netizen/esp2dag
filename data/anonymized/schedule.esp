      IF !LATE_SUBJECT = ' ' THEN
        DO
          ESP_SUBJECT = '!STD_LATE_SUBJECT'
        ENDDO
      ELSE
        DO
          ESP_SUBJECT = '!LATE_SUBJECT'
        ENDDO
