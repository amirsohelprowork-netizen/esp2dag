/* redacted */


GOOD_QUAL = 'Y'

REXXON GEN PROC  /* redacted */

GOOD_QUAL = 'Y'
IN_QUAL = CLANGVAR('!MNQUAL')
IF SUBSTR(IN_QUAL,1,1) = '~' THEN
  DO
    GOOD_QUAL = 'N'
  END

"GOOD_QUAL='"GOOD_QUAL"'"

REXXOFF          /* redacted */


IF !GOOD_QUAL = 'N' THEN -
  DO
    REM_SYMBOLIC_1A='Job !MNFULLNAME'
    REM_SYMBOLIC_1B='A job in appl !MNAPPL is FAILED. '
    REM_SYMBOLIC_2A='Job !MNFULLNAME'
  ENDDO
ELSE -
  DO
    REM_SYMBOLIC_1A='Job !MNFULLNAME..!MNQUAL'
    REM_SYMBOLIC_1B='A job in appl !MNAPPL is FAILED. '
    REM_SYMBOLIC_2A='Job !MNFULLNAME..!MNQUAL'
  ENDDO

REM_SYMBOLIC_2B='in appl !MNAPPL gen# !MNAPPLGEN is FAILED.'

IF !MNAGENT = '' THEN -
  DO
    REM_SYMBOLIC_3='SAP1174 JES job# is !MNJOBNO which'
    REM_SYMBOLIC_4='started at !MNJSTART.'
    REM_SYMBOLIC_5='This is a !MNJOBTYPE which ran on system !MNSYS.'
  ENDDO
ELSE -
  DO
    REM_SYMBOLIC_3='SAP1174 job# is !MNJOBNO which'
    REM_SYMBOLIC_4='started at !MNJSTART.'
    REM_SYMBOLIC_5='SAP1174 agent is !MNAGENT.'
  ENDDO

REM_SYMBOLIC_6='!MNFULLNAME'

REM_EXMK='!'


DOIT = '?'

REXXON GEN       /* redacted */

DOIT = '?'
IN_APPL = CLANGVAR('!MNAPPL')
IN_APPLGEN = CLANGVAR('!MNAPPLGEN')
IN_JOB = CLANGVAR('!MNJOB')
IN_QUAL = CLANGVAR('!MNQUAL')
/* redacted */
IF IN_QUAL = ''  THEN
  DO
    IN_JOBQUAL = IN_JOB
  END
ELSE
  DO
    IN_JOBQUAL = IN_JOB || '.' || IN_QUAL
  END
IN_TAG = CLANGVAR('!MNTAG')


IF SUBSTR(IN_TAG,3,4) = 'XXXX' THEN   /* redacted */
  DO                                  /* redacted */
    DOIT = 'TAG_SAYS_NO'
    SIGNAL ALL_DONE
  END


/* redacted */

LAP_COMMAND = 'ESP LAP' IN_APPL || '.' || IN_APPLGEN 'SAP088'

/* redacted */

X=TRAPOUT('HOLD.')

""LAP_COMMAND""

X=TRAPOUT('OFF')


/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */


/* redacted */

PARSE VAR HOLD.1 LAP_APPLCON LAP_APPL LAP_GENCON LAP_GEN THE_REST

IF LAP_APPLCON  \= 'APPL'     |,
  LAP_APPL      \= IN_APPL    |,
  LAP_GENCON    \= 'GEN'      |,
  LAP_GEN       \= IN_APPLGEN THEN
  DO
    DOIT = 'YES'
    SIGNAL ALL_DONE
  END

/* redacted */

DO I = 2
  IF HOLD.I = '' THEN                    /* redacted */
    DO                                   /* redacted */
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' THEN   /* redacted */
    DO                                   /* redacted */
      /* redacted */
      DOIT = 'YES'
      SIGNAL ALL_DONE
    END
  IF SUBSTR(HOLD.I,1,2) = '  ' THEN
    DO
      PARSE VAR HOLD.I LAP_1 THE_REST
      IF LAP_1 = IN_JOBQUAL THEN
        DO
          /* redacted */
          J = I + 1
          SIGNAL FOUND_IN_JOB
        END
    END
END


FOUND_IN_JOB:

DO I = J
  IF HOLD.I = '' THEN                 /* redacted */
    DO                                /* redacted */
      ITERATE
    END
  IF SUBSTR(HOLD.I,1,5) = '-----' |,  /* redacted */
     SUBSTR(HOLD.I,3,1) \= ' ' THEN   /* redacted */
    DO                                /* redacted */
      /* redacted */
      DOIT = 'YES'
      SIGNAL ALL_DONE
    END
  PARSE VAR HOLD.I LAP_1 LAP_2 THE_REST
  IF LAP_1 = 'Rerun' & LAP_2 = 'of:' THEN  /* redacted */
    DO                                     /* redacted */
      /* redacted */
      DOIT = 'NO'
      SIGNAL ALL_DONE
    END
END

ALL_DONE:

"DOIT='"DOIT"'"

REXXOFF                     /* redacted */


/* redacted */

/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */
/* redacted */

JOB JOB5013
  IF !DOIT = 'YES' THEN RUN NOW
ENDJOB

