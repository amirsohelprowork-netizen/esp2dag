AIX_JOB JOB3511 EXTERNAL APPLID(APP219) SCOPE(-01)
    RUN DAILY
    IF SYM0433('DEC 16,2022') GE 0 -
    AND DAYS_TO('JAN 01,2023') GE 0 -
    THEN NORUN DAILY
    IF SYM0433('DEC 14,2023') GE 0 -
    AND DAYS_TO('JAN 01,2024') GE 0 -
    THEN NORUN DAILY
    IF TODAY('DEC 17 2020') AND ESPSHH GT '18' THEN NORUN TODAY
    INVOKE 'SYM0174(APP003)'
    SAP973 ADD(JOB3602)
ENDJOB

JOB JOB3602 LINK PROCESS
   RUN DAILY
    IF ESPSHH = '11' THEN DELAYSUB 14.30
    IF ESPSHH = '19' THEN DELAYSUB 22.30
   SAP973 ADD(JOB5518)
ENDJOB

