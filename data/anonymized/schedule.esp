  DO
    JOB JOB5040
      ESP_BG_COLOR    = '#FF0000'
      ESP_RECIPIENT_1 = 'RCPT TO:<!LATE_EMAIL1>'
      ESP_RECIPIENT_2 = 'RCPT TO:<!LATE_EMAIL2>'
      ESP_RECIPIENT_3 = 'RCPT TO:<!LATE_EMAIL3>'
      ESP_RECIPIENT_4 = 'RCPT TO:<!LATE_EMAIL4>'
