    RUN DAILY
    IF DAYS_FROM('AUG 16,2023') GE 0 -
    AND DAYS_TO('AUG 17,2023') GE 0 -
    THEN NORUN DAILY
    IF DAYS_FROM('DEC 14,2023') GE 0 -
    AND DAYS_TO('JAN 01,2024') GE 0 -
    THEN NORUN DAILY
    IF TODAY('DEC 17 2020') AND ESPSHH GT '18' THEN NORUN TODAY
    INVOKE 'SYS.ESP.PROCLIB(APP001)'
