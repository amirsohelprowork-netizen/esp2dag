/*************************************************/
/* SYNTHETIC SAMPLE EVENTS (safe to commit)      */
/*************************************************/
EVENT ID(EV001.SAMPLEAPP)  USER(BATCHUSER)  OWNER(BATCHUSER)  SYSTEM(ESPSYS) -
       REPLACE
COM TEST EVENT FOR SAMPLEAPP
CALENDAR SYSTEM
SCHEDULE 11.00 DAILY STARTING FRI 17TH MAR 2023
SCHEDULE 19.00 DAILY STARTING FRI 17TH MAR 2023
INVOKE 'SYS.ESP.PROCLIB(SAMPLEAPP)'
ENDDEF

EVENT ID(EV002.SAPDEMO)  USER(BATCHUSER)  OWNER(BATCHUSER)  SYSTEM(ESPSYS) REPLACE
CALENDAR SYSTEM
SCHEDULE 08.03 EVERY 2 MINUTES STARTING FRI 17TH MAR 2023
INVOKE 'SYS.ESP.TESTLIB(SAPDEMO)'
ENDDEF

EVENT ID(EV003.OTHERAPP)  USER(BATCHUSER)  OWNER(BATCHUSER)  SYSTEM(ESPSYS) -
       REPLACE
COM DEPENDENCY UPSTREAM APP
CALENDAR SYSTEM
INVOKE 'SYS.ESP.PROCLIB(OTHERAPP)'
ENDDEF

EVENT ID(EV004.FILEDEMO)  USER(BATCHUSER)  OWNER(BATCHUSER)  SYSTEM(ESPSYS) REPLACE
CALENDAR SYSTEM
DSTRIG 'SYNTH.DATASET.001.G-' JOB(FTPAUTO) ANYCLOSE
INVOKE 'SYS.ESP.PROCLIB(FILEDEMO)'
ENDDEF
