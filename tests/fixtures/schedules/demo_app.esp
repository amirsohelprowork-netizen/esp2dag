APPL SAMPLEAPP WAIT

INVOKE 'SYS.ESP.PROCLIB(#DISTRIB)'

/* redacted */

NOTIFY FAILURE ABEND ALERT(ALERT01)
TAG DEMOTAG

JOB LIE.UPSTREAM EXTERNAL APPLID(OTHERAPP)
  RUN DAILY
  RELEASE ADD(LIS.!ESPAPPL)
ENDJOB

JOB LIS.!ESPAPPL LINK PROCESS
  RUN DAILY
  RELEASE ADD(AS400STEP)
ENDJOB

AS400_JOB AS400STEP
  RESOURCE ADD(1,RES01)
  AGENT AGENT01
  COMMAND CYBROBOT AS400STEP
  JOBQ QUEUE01
  RUN DAILY
  RELEASE ADD(WINSTEP)
ENDJOB

NT_JOB WINSTEP
  AGENT AGENT02
  CMDNAME D:\SCRIPTS\WINSTEP.bat
  ARGS
  USER CORP\batchuser
  RUN DAILY
  RELEASE ADD(UNIXSTEP)
ENDJOB

AIX_JOB UNIXSTEP
  AGENT AGENT03
  COMMAND /bin/sleep
  ARGS 3
  USER BATCHUSER
  RUN DAILY
ENDJOB
