APPL MIX WAIT
JOB LIE.A EXTERNAL APPLID(OTHER)
  RUN DAILY
  RELEASE ADD(LIS.!ESPAPPL)
ENDJOB
JOB LIS.!ESPAPPL LINK PROCESS
  RUN DAILY
  RELEASE ADD(S1)
ENDJOB
SAP_JOB S1
  AGENT SAP01
  ABAPNAME ZPROG
  VARIANT V1
  RUN DAILY
  RELEASE ADD(N1)
ENDJOB
NT_JOB N1
  AGENT WIN01
  CMDNAME D:\RUN\a.bat
  RUN DAILY
ENDJOB
