APPL SAMPLEA WAIT

INVOKE 'SYS.ESP.PROCLIB(#DISTRIB)'

/* redacted */

SCHD001= 'YESTERDAY'
SCHD002= 'YESTERDAY'

IF !USER2 = 001 THEN SCHD001 = 'TODAY'
IF !USER2 = 002 THEN SCHD002 = 'TODAY'

JOB SAMPLEJOB
  CCCHK RC(1:4095) OK CONTINUE
  RUN !SCHD001
ENDJOB

JOB SAMPLEJOB2
  CCCHK RC(1:4095) OK CONTINUE
  RUN !SCHD002
ENDJOB

APPL SAMPLEB WAIT

/* redacted */

JOB LINKJOB LINK PROCESS
  RUN DAILY
  RELEASE ADD(WORKJOB)
ENDJOB

JOB WORKJOB
  CCCHK RC(0:4) OK CONTINUE
  RUN DAILY
  /* COMPLETE APPL(OTHERAPP.0) must not split applications */
  COMPLETE APPL(OTHERAPP.0)
ENDJOB

APPL SAMPLEC WAIT
